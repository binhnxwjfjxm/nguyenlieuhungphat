# Clerk publishable key is safe for the browser. Never put CLERK_SECRET_KEY in this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CUSTOMER_ORDERING_KEY

# Production defaults to Core; use mock only for explicit local/test fallback.
NEXT_PUBLIC_CUSTOMER_ORDERING_DATA_MODE=core

# Server-only upstream base URL used by the same-origin Customer Portal BFF.
# No Core bootstrap/server token belongs in Customer Ordering.
CORE_API_BASE_URL=https://REPLACE_WITH_CORE_API_HOST

# Public R2 image URL only. Set the exact uploaded logo object URL here; no R2 secret is needed in the browser.
NEXT_PUBLIC_CUSTOMER_LOGO_URL=https://REPLACE_WITH_PUBLIC_R2_HOST/app-customer/image-system/REPLACE_WITH_LOGO_FILE
