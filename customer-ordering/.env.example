# Clerk publishable key is safe for the browser. Never put CLERK_SECRET_KEY in this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CUSTOMER_ORDERING_KEY

# Production defaults to Công Ty; use mock only for explicit local/test fallback.
NEXT_PUBLIC_CUSTOMER_ORDERING_DATA_MODE=core

# Server-only upstream base URL used by the same-origin Customer Portal BFF and AI metering.
# No Công Ty bootstrap/server token belongs in Customer Ordering.
CORE_API_BASE_URL=https://REPLACE_WITH_COMPANY_API_HOST

# Dedicated server-only capability accepted only for Customer Ordering AI context + usage writes.
ORDERING_AI_API_TOKEN=replace-with-distinct-ordering-ai-server-token

# Customer-facing Dialogflow CX runtime. Credentials stay server-side in Customer Ordering.
DIALOGFLOW_CX_SERVICE_ACCOUNT_JSON=<server-only-service-account-json>
DIALOGFLOW_CX_PROJECT_ID=<canonical-dialogflow-project-id>
DIALOGFLOW_CX_LOCATION=global
DIALOGFLOW_CX_AGENT_ID=<canonical-dialogflow-agent-id>
DIALOGFLOW_CX_AGENT_DISPLAY_NAME=Hưng Phát
DIALOGFLOW_CX_LANGUAGE_CODE=vi
